<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="generator" content="{{ eleventy.generator }}" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
  <link rel="stylesheet" href="/styles.css" />
  <title>{{ bio.name }}{%if title%} / {{ title }}{%endif%}</title>
  <link rel="icon" href="/favicon.png" />
</head>
<body>
  <div class="terminal">
    <header>
      <h1><a href="/">{{ bio.name | upcase }}()</a></h1>
      <p>User Manual</p>
      <p class="generated-date">Generated on<br>{{ generatedDate | date: "%Y-%m-%d" }}</p>
    </header>
    <nav>
      <h2>NAVIGATION</h2>
      <ol>
        {%- for item in collections.nav -%}
        <li
          {% if page.url == item.url %}aria-current="page"{% endif %}
        >
          <a href="{{ item.url }}">{{ item.data.title }}</a>
        </li>
        {%- endfor -%}
      </ol>
    </nav>
    <main>
      {%if title%}<h1>{{ title }}</h1>{%endif%}
      {%if date%}<p>Published on <time datetime="{{ date }}">{{ date | date: "%Y-%m-%d" }}</time></p>{%endif%}
      {{ content }}
    </main>
  </div>
</body>
</html>
