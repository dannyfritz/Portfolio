---
  bio:
    name: Danny Fritz
---
<html lang="en">
<head>
  <meta name="generator" content="{{ eleventy.generator }}">
  <style>
  img {
    max-width: min(100vw, 100%);
  }
  mjx-assistive-mml {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .markdown-alert-warning {
    border: 1px solid red;
  }
  .details, .info {
    border: 1px solid;
  }
  </style>
  <title>{{ bio.name }}{%if title%} / {{ title }}{%endif%}</title>
</head>
<body>
  <header>
    <h1>{{ bio.name }}</h1>
    <p>Generated on {{ generatedDate | date: "%Y-%m-%d" }}</p>
    <nav>
      <h2>Navigation:</h2>
      <ol>
        {%- for item in collections.nav -%}
        <li
          {% if page.url == item.url %}aria-current="page"{% endif %}
        >
          <a href="{{ item.url }}">{{ item.data.title }}</a>
        </li>
        {%- endfor -%}
      </ol>
    </nav>
    {%if title%}<h2>{{ title }}</h2>{%endif%}
  </header>
  <main>
    {{ content }}
  </main>
</body>
</html>
