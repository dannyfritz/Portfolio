---
  layout: layout
  title: Projects
  tags: nav
---
<ol>
{% for project in projects %}
  <li>
    <h3>{{ project.title }}</h3>
    <img src="{{project.image}}">
    <p>{{ project.description }}</p>
    <ul>
      {% for link in project.links %}
      <li><a href="{{ link.url }}">{{ link.text }}</a>
      {% endfor %}
    </ul>
  </li>
{% endfor %}
</ol>
