---
  layout: layout
  title: Blog
  tags: nav
---
<ol>
{%- for post in collections.post reversed -%}
  <li>
    {{ post.data.date | date: "%Y-%m-%d" }}
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    {% if post.data.summary %}<small>{{ post.data.summary }}</small>{% endif %}
  </li>
{%- endfor -%}
</ol>
