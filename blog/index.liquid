---
  layout: layout
  title: Blog
  tags: nav
---
<style>
.posts {
  margin-top: 0;
  li {
    display: flex;
    flex-direction: column;
  }
  li ~ li {
    padding-top: 1cap;
  }
  a {
    color: var(--secondary);
  }
  small, time {
    color: var(--muted);
  }
}
</style>
<p>Subscribe to the <a href="/feed.xml">atom feed</a> using your favorite feed aggregator</p>
<ol class="posts">
  {%- for post in collections.post reversed -%}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <time datetime="{{ post.data.date }}">{{ post.data.date | date: "%Y-%m-%d" }}</time>
    {% if post.data.summary %}
    <small>{{ post.data.summary }}</small>
    {% endif %}
  </li>
  {%- endfor -%}
</ol>
